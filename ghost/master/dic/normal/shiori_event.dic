//******************************************************************************
// YAYA
// 自分で追加した shiori Event
//******************************************************************************

OnBalloonBreak
{
    isTalking = 0
}

OnBalloonClose
{
    isTalking = 0
}

OnBalloonTimeout
{
    isTalking = 0
}

//------------------------------------------------------------------------------
// OnMouseClick
//------------------------------------------------------------------------------

OnMouseClick
{
	if reference3 == 1 && reference4 == 'ActionUI' && reference5 == 0{
		_actionID = reference0 / 137

		'\_q\u\![bind,アクション,,0]\h\_q'
		--
		case _actionID{
			when 0{
				Action_Fold
			}
			when 1{
				if temp_maxBet == 0{
					Action_Check
				}
				else{
					Action_Call
				}
			}
			when 2{
				temp_ChoiseExRef = temp_smallBet
				if temp_maxBet == 0{
					Action_Bet
				}
				else{
					Action_Raise
				}
			}
			when 3{
				temp_ChoiseExRef = temp_halfBet
				if temp_maxBet == 0{
					Action_Bet
				}
				else{
					Action_Raise
				}
			}
			when 4{
				temp_ChoiseExRef = temp_bigBet
				if temp_maxBet == 0{
					Action_Bet
				}
				else{
					Action_Raise
				}
			}
			when 5{
				Action_AllIn
			}
		}
	}
}

//------------------------------------------------------------------------------
//OnMinuteChangeイベント
//------------------------------------------------------------------------------

OnMinuteChange
{

}

//------------------------------------------------------------------------------
//OnSecondChangeイベント
//1 秒毎に実行される。ここではあまり重い処理を行わないこと
//---------------------------------------------------------------------------

OnSecondChange
{
	if chainTimer > 0{
        chainTimer--
        if chainTimer == 0{
            ChainCommunicateTimerReset()
        }
    }

/*
    if holdTimer > 0{
        holdTimer--
        if holdTimer == 0{
            StartHoldCommunicate()
        }
    }
*/
    holdTimer++
}

